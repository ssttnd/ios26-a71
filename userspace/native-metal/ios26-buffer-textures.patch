+rwa_texture_from_buffer(struct rwa_buffer *buffer, const struct rwa_texture_shape *shape,
+                        size_t offset, size_t row_bytes, char *why, size_t why_size)
+{
+   if (!buffer || !shape || shape->type != 2 || !shape->width || !shape->height ||
+       shape->depth != 1 || shape->array_length != 1 || shape->mip_levels != 1 ||
+       shape->sample_count != 1 || offset > buffer->size || offset % 64 ||
+       !row_bytes || row_bytes % 64 || row_bytes > (buffer->size - offset) / shape->height) {
+      say(why, why_size, "invalid 2D linear buffer texture shape, alignment or bounds");
+      return NULL;
+   }
+   const struct rwa_surface_import import = {
+      .offset = offset, .row_bytes = row_bytes, .buffer = buffer,
+   };
+   return texture_of_shape(buffer->device, shape, &import, why, why_size);
 }
 
