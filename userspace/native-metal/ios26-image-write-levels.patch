+static void
+native_drawlog_texstat(unsigned seq, id t)
+{
+	if (t == nil || [t sampleCount] > 1)
+		return;
+	const unsigned fmt = (unsigned)[t pixelFormat];
+	if (fmt != 80 && fmt != 81 && fmt != 70 && fmt != 71) {
+		fprintf(stderr, "SweetNativeMetal: TEXSTAT %u format %u not read\n", seq, fmt);
+		return;
+	}
+	unsigned levels = (unsigned)[t mipmapLevelCount];
+	levels = levels == 0 ? 1 : levels > 4 ? 4 : levels;
+	for (unsigned l = 0; l < levels; l++) {
+		unsigned w = (unsigned)[t width] >> l, h = (unsigned)[t height] >> l;
+		w = w ? w : 1;
+		h = h ? h : 1;
+		const size_t n = (size_t)w * h;
+		uint8_t *px = malloc(n * 4);
+		if (px == NULL)
+			return;
+		memset(px, 0xee, n * 4);
+		[t getBytes:px bytesPerRow:w * 4 fromRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:l];
+		uint64_t s[4] = { 0 };
+		size_t clear = 0;
+		for (size_t i = 0; i < n; i++) {
+			for (unsigned k = 0; k < 4; k++)
+				s[k] += px[i * 4 + k];
+			clear += px[i * 4 + 3] == 0;
+		}
+		fprintf(stderr, "SweetNativeMetal: TEXSTAT %u L%u %ux%u mean %u,%u,%u,%u clear %u%%\n", seq, l, w, h,
+		        (unsigned)(s[0] / n), (unsigned)(s[1] / n), (unsigned)(s[2] / n), (unsigned)(s[3] / n),
+		        (unsigned)(clear * 100 / n));
+		free(px);
+	}
+}
+
+static void
+native_glassstat(const void *render)
+{
+	static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+	static uint64_t window_ms;
+	static unsigned draws, glass_bg, glass_fg, blur;
+	static const void *last_render;
+	static int last_cat;
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	const uint64_t ms = (uint64_t)now.tv_sec * 1000 + (uint64_t)now.tv_nsec / 1000000;
+	int cat = 0;
+	bool known = false;
+	pthread_mutex_lock(&lock);
+	if (render == last_render) {
+		cat = last_cat;
+		known = true;
+	}
+	pthread_mutex_unlock(&lock);
+	if (!known) {
+		char f[48] = "";
+		pthread_mutex_lock(&native_drawlog_lock);
+		struct native_drawlog_name *e = native_drawlog_slot(render, false);
+		if (e)
+			memcpy(f, e->ffn, sizeof(f));
+		pthread_mutex_unlock(&native_drawlog_lock);
+		f[sizeof(f) - 1] = 0;
+		cat = !strncmp(f, "glass_background", 16) ? 1 :
+		      !strncmp(f, "glass_foreground", 16) ? 2 :
+		      (strstr(f, "blur") || strstr(f, "downsample") || strstr(f, "upsample")) ? 3 : 0;
+	}
+	pthread_mutex_lock(&lock);
+	last_render = render;
+	last_cat = cat;
+	if (!window_ms)
+		window_ms = ms;
+	if (ms - window_ms >= 1000) {
+		if (draws)
+			fprintf(stderr, "SweetNativeMetal: GLASSSTAT %llu ms: draws %u glass_bg %u "
+			        "glass_fg %u blur %u\n", (unsigned long long)(ms - window_ms), draws,
+			        glass_bg, glass_fg, blur);
+		window_ms = ms;
+		draws = glass_bg = glass_fg = blur = 0;
+	}
+	draws++;
+	glass_bg += cat == 1;
+	glass_fg += cat == 2;
+	blur += cat == 3;
+	pthread_mutex_unlock(&lock);
+}
+
+/* CoreAnimation's luma_boost_lph/lpf (QuartzCore 23G90): out.rgb = d0.rgb +
+ * scale * edr * LUT(luma(d0) * inv_edr), an EDR brightness lift drawn over the finished
+ * frame with framebuffer fetch. backboardd runs it full-screen on the A71, whose panel has
+ * no EDR, and the wallpaper came out about twice as bright (owner, 2026-11-22). The draw
+ * only adds light, so leaving it out leaves the frame as composited.
+ * /var/local/sweet-mtl-skip-luma-boost present = skip it. */
+static bool
+native_skip_luma_boost(const void *render)
+{
+	static int skip = -1;
+	static const void *last_render;
+	static bool last_is;
+	if (skip < 0) {
+		skip = access("/var/local/sweet-mtl-skip-luma-boost", F_OK) == 0;
+		fprintf(stderr, "SweetNativeMetal: luma_boost draws %s (/var/local/sweet-mtl-skip-luma-boost)\n",
+		        skip ? "skipped" : "drawn");
+	}
+	if (!skip)
+		return false;
+	if (render == last_render)
+		return last_is;
+	char f[48] = "";
+	pthread_mutex_lock(&native_drawlog_lock);
+	struct native_drawlog_name *e = native_drawlog_slot(render, false);
+	if (e)
+		memcpy(f, e->ffn, sizeof(f));
+	pthread_mutex_unlock(&native_drawlog_lock);
+	f[sizeof(f) - 1] = 0;
+	last_render = render;
+	last_is = !strncmp(f, "luma_boost_", 11);
+	static unsigned told;
+	if (last_is && told++ < 4)
+		fprintf(stderr, "SweetNativeMetal: skipped %s draw\n", f);
+	return last_is;
 }
 
