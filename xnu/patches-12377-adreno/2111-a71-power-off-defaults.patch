A71 (port of iOS 16 0204 without its 0198 framebuffer part): power off from iOS through PSCI
SYSTEM_OFF (restart stays with sweet_reboot.c, which keeps the reboot reason), GPU start delay 15 s,
charge current 1000 mA by default, Wi-Fi signal defaults.

diff --git a/bsd/dev/flame_sta.c b/bsd/dev/flame_sta.c
index 8fc9866..b265c6e 100644
--- a/bsd/dev/flame_sta.c
+++ b/bsd/dev/flame_sta.c
@@ -151,6 +151,16 @@ sta_state(struct redwood_sta_state *state)
 			}
 		}
 	}
+	/* 0204: the signal as of the latest (background) scan, not the one from the moment of the join */
+	if (state->phase == REDWOOD_STA_JOINED) {
+		struct flame_wlan_bss t;        /* (on any thread: not static) */
+		for (unsigned i = 0; flame_wlan_heard(i, &t); i++) {
+			if (memcmp(t.bssid, state->bss.bssid, 6) == 0 && t.age_ms < 60000) {
+				state->bss.rssi = t.rssi;
+				break;
+			}
+		}
+	}
 	state->last_error = sta_last_error;
 }
 
diff --git a/bsd/dev/redwood_apple80211.c b/bsd/dev/redwood_apple80211.c
index e2674ee..1c7e5e1 100644
--- a/bsd/dev/redwood_apple80211.c
+++ b/bsd/dev/redwood_apple80211.c
@@ -259,6 +259,10 @@ give_network(const struct apple80211req *request, const struct redwood_sta_bss *
 	result->version = 1;
 	channel_fill(&result->channel, bss->frequency, 0);
 	result->rssi = bss->rssi;
+	/* 0204: with noise unknown the status bar drew no bars; a typical 2.4 GHz floor */
+	result->noise_known = 1;
+	result->noise = -95;
+	result->snr = bss->rssi < 0 && bss->rssi > -95 ? (int16_t)(bss->rssi + 95) : 0;
 	result->beacon_interval = bss->beacon_interval;
 	result->capability = bss->capability;
 	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
@@ -648,6 +652,8 @@ redwood_apple80211_event(enum redwood_sta_event event, int status)
 		if (state != NULL) {
 			redwood_sta_state(state);
 			link.rssi = status == 1 ? state->bss.rssi : 0;
+			link.noise = (uint16_t)(int16_t)-95;
+			link.snr = status == 1 && state->bss.rssi > -95 && state->bss.rssi < 0 ? (uint16_t)(state->bss.rssi + 95) : 0;
 			kfree_data(state, sizeof(*state));
 		}
 		post(EVENT_SSID_CHANGED, NULL, 0);
