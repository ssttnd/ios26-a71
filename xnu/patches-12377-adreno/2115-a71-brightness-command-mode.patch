A71 (iOS 16 0200 + 0214 onto donor 2005 DCS brightness): on samsung,a71 accept DSI0 in command
mode, scale to the S6E3FA9 range 8..1023 and send 53 20 (brightness control on) once before the
first 51 level. sweet stays video mode, 8..2047.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 04e008a..ea1941d 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -597,21 +597,71 @@ OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 #define DSI_REG_TPG_FIFO_RESET  0x1ec
 #define DSI_REG_VERSION         0x1f4
 #define SWEET_DCS_BL_MIN        8u
-#define SWEET_DCS_BL_MAX        2047u
+#define SWEET_DCS_BL_MAX_SWEET  2047u
+/* A71 (iOS 16 0214): S6E3FA9 in command mode, DT gamma_mode2_tx_cmds ends 51 03 ff; 53 20 turns brightness control on. */
+#define SWEET_DCS_BL_MAX_A71    1023u
+#define SWEET_DCS_BL_MAX        (sweet_dcs_a71 ? SWEET_DCS_BL_MAX_A71 : SWEET_DCS_BL_MAX_SWEET)
+static bool sweet_dcs_a71;
 static volatile uint32_t *sweet_dcs_dsi;
 static thread_call_t sweet_dcs_call;
 static uint32_t sweet_dcs_wanted, sweet_dcs_sent;
 static unsigned sweet_dcs_failures;
 
+/* DSI0 CTRL bit 0 engine, bit 1 video, bit 2 command: sweet's panel runs in video mode, the A71's in command mode. */
+static inline bool
+sweet_dcs_dsi_on(uint32_t ctrl)
+{
+	return sweet_dcs_a71 ? ((ctrl & 1) && (ctrl & 6)) : (ctrl & 3) == 3;
+}
+
+/* DCS short write with one parameter (data id 0x15), as iOS 16 0214 sweet_bl_write_control. */
+static void
+sweet_dcs_short(volatile uint32_t *dsi, uint32_t cmd, uint32_t param)
+{
+	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4], dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
+	const uint32_t word = cmd | (param << 8) | (0x15u << 16) | (0x80u << 24);
+	dsi[DSI_REG_CTRL / 4] = ctrl | (1u << 2);
+	dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	dsi[DSI_REG_TPG_CTRL / 4] = (1u << 1) | (1u << 2) | (3u << 16);
+	dsi[DSI_REG_TPG_DMA_DATA / 4] = word;
+	dsi[DSI_REG_DMA_CTRL / 4] = (dma_ctrl & ~((1u << 31) | (1u << 30))) | (1u << 26) | (1u << 28);
+	dsi[DSI_REG_DMA_LENGTH / 4] = sizeof(word);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dsi[DSI_REG_DMA_TRIGGER / 4] = 1;
+	unsigned us;
+	for (us = 0; us < 50000 && !(dsi[DSI_REG_INT_CTRL / 4] & 1u); us += 50) {
+		IODelay(50);
+	}
+	const bool done = (dsi[DSI_REG_INT_CTRL / 4] & 1u) != 0;
+	if (done) {
+		dsi[DSI_REG_INT_CTRL / 4] = dsi[DSI_REG_INT_CTRL / 4] | 1u;
+	}
+	dsi[DSI_REG_TPG_CTRL / 4] = 0;
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 1;
+	IODelay(1);
+	dsi[DSI_REG_TPG_FIFO_RESET / 4] = 0;
+	dsi[DSI_REG_DMA_CTRL / 4] = dma_ctrl;
+	if (!(ctrl & (1u << 2))) {
+		dsi[DSI_REG_CTRL / 4] = dsi[DSI_REG_CTRL / 4] & ~(1u << 2);
+	}
+	IOLog("SWEET BL: DCS %02x %02x %s after %u us ack_err=%#x\n", cmd, param, done ? "sent" : "NOT acknowledged", us,
+	    dsi[DSI_REG_ACK_ERR / 4]);
+}
+
 static int
 sweet_dcs_send(uint32_t level)
 {
 	volatile uint32_t *dsi = sweet_dcs_dsi;
 	const uint32_t ctrl = dsi[DSI_REG_CTRL / 4];
-	if ((ctrl & 3) != 3) {
-		IOLog("SWEET BL: DSI0 left video mode (ctrl=%#x); level %u not sent\n", ctrl, level);
+	if (!sweet_dcs_dsi_on(ctrl)) {
+		IOLog("SWEET BL: DSI0 off or out of its mode (ctrl=%#x); level %u not sent\n", ctrl, level);
 		return ENODEV;
 	}
+	static bool control_sent;
+	if (sweet_dcs_a71 && !control_sent) {
+		control_sent = true;
+		sweet_dcs_short(dsi, 0x53u, 0x20u);
+	}
 	const uint32_t dma_ctrl = dsi[DSI_REG_DMA_CTRL / 4];
 	/* DCS long write: header {WC lsb, WC msb, data id 0x39, LAST|LONG}, then 0x51 hi lo, 0xff pad. */
 	const uint32_t words[2] = {
@@ -677,7 +727,8 @@ sweet_dcs_init(void)
 	if (!on || sweet_board_beryllium()) {
 		return false;
 	}
-	sweet_dcs_dsi = (volatile uint32_t *)ml_io_map(SWEET_DSI0_PA, 0x400);
+	sweet_dcs_a71 = sweet_board_is("samsung,a71");
+	sweet_dcs_dsi =(volatile uint32_t *)ml_io_map(SWEET_DSI0_PA, 0x400);
 	sweet_dcs_call = thread_call_allocate(sweet_dcs_apply, NULL);
 	if (sweet_dcs_dsi == NULL || sweet_dcs_call == NULL) {
 		IOLog("SWEET BL: DCS brightness: no DSI0 mapping or thread call\n");
@@ -686,8 +737,8 @@ sweet_dcs_init(void)
 	const uint32_t ctrl = sweet_dcs_dsi[DSI_REG_CTRL / 4];
 	IOLog("SWEET BL: DSI0 version=%#x ctrl=%#x dma_ctrl=%#x int=%#x\n", sweet_dcs_dsi[DSI_REG_VERSION / 4], ctrl,
 	    sweet_dcs_dsi[DSI_REG_DMA_CTRL / 4], sweet_dcs_dsi[DSI_REG_INT_CTRL / 4]);
-	if ((ctrl & 3) != 3) {
-		IOLog("SWEET BL: DSI0 is not enabled in video mode; no DCS brightness\n");
+	if (!sweet_dcs_dsi_on(ctrl)) {
+		IOLog("SWEET BL: DSI0 is not enabled (ctrl=%#x); no DCS brightness\n", ctrl);
 		return false;
 	}
 	IOLog("SWEET BL: DCS brightness ready (0x51, levels %u..%u; sweetfb_dcsbl=0 disables)\n", SWEET_DCS_BL_MIN, SWEET_DCS_BL_MAX);
