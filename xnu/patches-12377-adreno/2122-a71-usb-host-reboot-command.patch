A71: commands from the PC on the USB serial port (sweetusb=3). A line "a71:recovery" (or "a71:reboot",
"a71:bootloader") reboots the phone into that mode through reboot_kernel (file systems synced) and
sweet_reboot.c, which now also runs on samsung,a71 (same SM7150 IMEM restart_reason 0x146aa65c and PM6150
PON spare 0x88f as sweet). Lets the PC take the phone from iOS to TWRP without the key combo.

diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
index dbea036..d4c5793 100644
--- a/bsd/dev/sweet_reboot.c
+++ b/bsd/dev/sweet_reboot.c
@@ -151,7 +151,8 @@ sweet_reboot_init(void)
 	 * with the PON and IMEM reasons set first, so `sweetreboot fastboot` lands in ABL fastboot.
 	 */
 	const bool sweet = !sweet_board_beryllium();
-	if (sr_ready || (sweet && !sweet_board_is("xiaomi,sweet"))) {
+	/* 2122: the A71 is the same SM7150 + PM6150 (IMEM 0x146aa000, PON spare 0x88f) */
+	if (sr_ready || (sweet && !sweet_board_is("xiaomi,sweet") && !sweet_board_is("samsung,a71"))) {
 		return;
 	}
 	if (PE_parse_boot_argn("sweetreboot", arg, sizeof(arg))) {
@@ -203,6 +204,17 @@ sr_pon_set_reason(unsigned magic)
 	printf("SWEET REBOOT: PON_SOFT_RB_SPARE 0x88f 0x%02x -> 0x%02x (read back 0x%02x)\n", old, upd, back);
 }
 
+/* 2122: the mode of the next reboot, from the kernel (USB host command): 0 normal,
+ * 1 bootloader, 2 recovery, as the sysctl would set it. */
+void sweet_reboot_set_mode(int mode);
+void
+sweet_reboot_set_mode(int mode)
+{
+	sr_override = mode == 2 ? SR_RECOVERY : mode == 1 ? SR_BOOTLOADER : SR_NORMAL;
+	printf("SWEET REBOOT: next reboot mode set to %s (kernel)"
+	    "\n", sr_name(sr_override));
+}
+
