A71: the calendar set from the PM6150 RTC (2108) was overwritten by clock_initialize_calendar() in
IOKitInitializeTime(), which reads PEGetUTCTimeOfDay with no RTC behind it: userland ran at 1969-12-31
(os_log stamps, lock screen date) and RunningBoard refused MercuryPoster rendering assertions as
"invalidation time is in the past". The RTC is read again right after it. The wait for an IORTC
resource that never appears on these phones drops from 30 s to 2 s.

diff --git a/iokit/Kernel/IOStartIOKit.cpp b/iokit/Kernel/IOStartIOKit.cpp
index 3530886..7097c67 100644
--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -69,6 +69,10 @@ SECURITY_READ_ONLY_LATE(static IOPlatformExpertDevice*) gRootNub;
 #include <kern/clock.h>
 #include <sys/time.h>
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern "C" void sweet_rtc_set_calendar(void);   /* iokit/Kernel/arm/SweetBattery.cpp (2123) */
+#endif
+
 void
 IOKitInitializeTime( void )
 {
@@ -76,6 +80,9 @@ IOKitInitializeTime( void )
 
 	t.tv_sec = 30;
 	t.tv_nsec = 0;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	t.tv_sec = 2;   /* 2123: no IORTC on these phones; the PM6150 RTC is set below */
+#endif
 
 	IOService::waitForService(
 		IOService::resourceMatching("IORTC"), &t );
@@ -85,6 +92,9 @@ IOKitInitializeTime( void )
 #endif
 
 	clock_initialize_calendar();
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_rtc_set_calendar();
+#endif
 }
 
 void
diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index 3ab4ca9..df86dac 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -597,6 +597,22 @@ sweetSetCalendarFromRtc(void)
 	IOLog("SWEET RTC: PM6150 RTC kept moving while read\n");
 }
 
+/*
+ * 2123: IOKitInitializeTime() runs clock_initialize_calendar() after this driver has set the
+ * calendar, and that takes the time from PEGetUTCTimeOfDay, which has no RTC behind it on this
+ * board: the calendar went back to the epoch and userland lived in 1969-12-31 (os_log stamps,
+ * lock screen date; RunningBoard then refused MercuryPoster's rendering assertions as "in the
+ * past", so the wallpaper never drew). Called right after it, this reads the PM6150 RTC again.
+ */
+extern "C" void sweet_rtc_set_calendar(void);
+extern "C" void
+sweet_rtc_set_calendar(void)
+{
+	if (sweet_spmi_init() == 0) {
+		sweetSetCalendarFromRtc();
+	}
+}
+
 bool
 SweetBattery::start(IOService *provider)
 {
