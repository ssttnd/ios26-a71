+/*
+ * 2125: keep a frame the gate took unfinished (after its 100 ms cap) for a second copy once its GPU work completes. Its
+ * surfaces get their own hold, so CoreAnimation does not draw into them before that copy; a newer swap cancels it.
+ * fLock held.
+ */
+void
+AppleCLCD::armRecopy(const uint8_t *rec, SweetSurface *const *taken, uint32_t fence)
+{
+	static int on = -1;
+	if (on < 0) {
+		int v = 1;
+		PE_parse_boot_argn("sweetfb_recopy", &v, sizeof(v));
+		on = v != 0;
+		IOLog("SWEET FB: frames shown unfinished are %s (sweetfb_recopy)
+",
+		    on ? "copied again when their GPU work completes" : "left as shown");
+	}
+	if (!on || fEarly) {
+		return;
+	}
+	if (fRecopy) {
+		sweet_hold_release(fRecopyHold);
+	}
+	memcpy(fRecopyRec, rec, SWEET_FB_SWAP_REC_SIZE);
+	for (uint32_t i = 0; i < 4; i++) {
+		fRecopyHold[i] = taken[i];
+		if (taken[i] != NULL) {
+			taken[i]->retain();
+			sweet_hold(taken[i], true);
+		}
+	}
+	fRecopyFence = fence;
+	fRecopy = true;
+}
