+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+static void
+ud_acm_cover_capture(void)
+{
+	int enabled = 0;
+	if (!PE_parse_boot_argn("sweetusbui", &enabled, sizeof(enabled)) || !enabled) {
+		printf("SWEET USB: UI gesture request disabled\n");
+		return;
+	}
+
+	/* A71 panel coordinates. Start at top centre, away from Control Center. */
+	const int x = 540, top = 4, bottom = 1740, steps = 24;
+	for (int i = 0; i <= steps; i++) {
+		sweet_hid_touch(0, 1, x, top + (bottom - top) * i / steps);
+		ud_sleep_ms(16);
+	}
+	sweet_hid_touch(0, 0, x, bottom);
+	ud_sleep_ms(350);
+	ud_acm_capture();
+}
