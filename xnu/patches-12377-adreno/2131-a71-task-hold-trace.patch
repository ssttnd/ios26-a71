+/*
+ * 2131 (A71): log task holds (task_suspend, task_suspend2, pid_suspend and their resumes) of the
+ * processes named in sweetdtlog, with the caller. Settings hangs when it is reopened from the
+ * background: its os_log stops at didEnterBackground and nothing is logged on the reopen, so the
+ * question is whether it stays suspended. At most 400 lines.
+ */
+extern bool sweet_dtlog_listed(const char *name);
+static int _Atomic sweet_task_hold_logged;
+
+static void
+sweet_task_hold_log(const char *what, task_t task, int mode, kern_return_t kr)
+{
+	if (task == TASK_NULL || get_bsdtask_info(task) == NULL) {
+		return;
+	}
+	const char *name = task_best_name(task);
+	if (name == NULL || !sweet_dtlog_listed(name)) {
+		return;
+	}
+	if (os_atomic_inc(&sweet_task_hold_logged, relaxed) > 400) {
+		return;
+	}
+	task_t caller = current_task();
+	const char *by = (caller != TASK_NULL && get_bsdtask_info(caller) != NULL) ? task_best_name(caller) : "kernel";
+	printf("SWEET TASKHOLD: %s %s[%d] mode %d -> %d: user_stop %u legacy %u pidsuspended %d by %s[%d]\n",
+	    what, name, task_pid(task), mode, kr, (unsigned)task->user_stop_count,
+	    (unsigned)task->legacy_stop_count, (int)task->pidsuspended, by ? by : "?",
+	    caller != TASK_NULL ? task_pid(caller) : -1);
+}
+
+static kern_return_t
+place_task_hold(
+	task_t task,
+	int mode)
+{
+	kern_return_t kr = place_task_hold_impl(task, mode);
+	sweet_task_hold_log("hold", task, mode, kr);
+	return kr;
+}
+
+static kern_return_t
+release_task_hold(
+	task_t          task,
+	int                     mode)
+{
+	kern_return_t kr = release_task_hold_impl(task, mode);
+	sweet_task_hold_log("release", task, mode, kr);
+	return kr;
+}
+
 boolean_t
 get_task_suspended(task_t task)
 {
