A71: boot-args beyond the shim's 608 bytes. The shim payload carries cmdline[608]; XNU 12377's arm64
boot_args has CommandLine[1024] and arm_init copies it into its own const_boot_args. PE_init_platform now
appends the ADT property /chosen "sweet-boot-args" (written by tools/a71-pack-ios26.py when the line is too
long) to that copy right after SecureDTInit. Arguments parsed earlier (debug, serial, -v, early framebuffer)
must stay in the shim's part; the packer moves only the tail.

diff --git a/pexpert/arm/pe_init.c b/pexpert/arm/pe_init.c
index db1c4a0..7f14021 100644
--- a/pexpert/arm/pe_init.c
+++ b/pexpert/arm/pe_init.c
@@ -466,6 +466,33 @@ PE_init_platform(boolean_t vm_initialized, void *args)
 		 * can be used..
 		 */
 		SecureDTInit(PE_state.deviceTreeHead, PE_state.deviceTreeSize);
+		{
+			/*
+			 * 2140 (A71): more boot-args from the ADT. The shim's payload holds 608 bytes of command
+			 * line, the kernel's boot_args 1024; tools/a71-pack-ios26.py puts what does not fit into
+			 * /chosen "sweet-boot-args", appended here to the kernel's own copy (const_boot_args,
+			 * still writable this early). Only arguments parsed after this point see the extra part.
+			 */
+			DTEntry chosen_e;
+			const char *extra = NULL;
+			unsigned int extra_size = 0;
+			if (kSuccess == SecureDTLookupEntry(NULL, "/chosen", &chosen_e) &&
+			    kSuccess == SecureDTGetProperty(chosen_e, "sweet-boot-args", (void const **)&extra, &extra_size) &&
+			    extra && extra_size > 1) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wcast-qual"
+				char *cl = (char *)boot_args_ptr->CommandLine;
+#pragma clang diagnostic pop
+				size_t have = strnlen(cl, BOOT_LINE_LENGTH);
+				if (have + 2 < BOOT_LINE_LENGTH) {
+					cl[have++] = ' ';
+					for (unsigned int i = 0; i < extra_size && extra[i] && have + 1 < BOOT_LINE_LENGTH; i++) {
+						cl[have++] = extra[i];
+					}
+					cl[have] = 0;
+				}
+			}
+		}
 		pe_identify_machine(boot_args_ptr);
 	} else {
 		pe_arm_init_interrupts(args);
