+/* The Samsung controller uses the same GENI pins as sweet, but different rails. */
+static bool
+touch_a71_start(void)
+{
+	st.gpio_west = ml_io_map(0x03500000u, 0x40000);
+	if (!st.gpio_west) {
+		return false;
+	}
+	int bitbang = 1;
+	(void)PE_parse_boot_argn("sweettouchbitbang", &bitbang, sizeof(bitbang));
+	st.bitbang = bitbang != 0;
+	if (!st.bitbang && (!touch_clocks() || !touch_se_init())) {
+		return false;
+	}
+	int power_error = sweet_rpmh_vreg_enable("ldoc11", 3200);
+	if (power_error) {
+		printf("SWEET TOUCH: Samsung L11C vote returned %d\n", power_error);
+	}
+	touch_gpio_west(56, 0, 0, 0, true, true); /* tsp_ldo_en, AVDD */
+	if (!touch_power_dvdd()) {
+		printf("SWEET TOUCH: Samsung DVDD configuration failed\n");
+		return false;
+	}
+	touch_wait(80);
+	touch_gpio(tb->rst, 0, 3, 3, true, false);
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 3, 3, true, true);
+	touch_gpio(tb->irq, 0, 3, 3, false, false);
+	unsigned mux = st.bitbang ? 0 : tb->mux;
+	touch_gpio(tb->sda, mux, 3, 2, false, false);
+	touch_gpio(tb->scl, mux, 3, 2, false, false);
+	touch_wait(80);
+
+	uint8_t sid[5] = {0};
+	int err = touch_read(SEC_TS_I2C_ADDR, SEC_TS_READ_ID, false, sid, sizeof(sid));
+	bool matched = (sid[0] == 0xac && sid[1] == 0x37) ||
+	    (sid[0] == 0x53 && sid[1] == 0x45 && sid[2] == 0x37 && sid[3] == 0x71);
+	if (err || !matched) {
+		printf("SWEET TOUCH: Samsung S6SY771 not found (err=%d, id=%02x%02x%02x%02x)\n",
+		    err, sid[0], sid[1], sid[2], sid[3]);
+		return false;
+	}
+	/* sec_ts enables TOUCH, PALM and WET before sensing. */
+	const uint8_t functions[] = {0x30, 0x61, 0x00};
+	const uint8_t sense = SEC_TS_CMD_SENSE_ON;
+	const uint8_t clear = SEC_TS_CMD_CLEAR_EVENT_STACK;
+	if (touch_sec_write(functions, sizeof(functions)) || touch_sec_write(&sense, 1)) {
+		printf("SWEET TOUCH: Samsung S6SY771 could not enable sensing\n");
+		return false;
+	}
+	touch_wait(10);
+	(void)touch_sec_write(&clear, 1);
+	st.kind = TOUCH_SEC_TS;
+	return true;
+}
